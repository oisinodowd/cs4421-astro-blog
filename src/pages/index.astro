---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
export const prerender = true;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="page-shell">
			<section class="hero">
				<p class="eyebrow">Scores, games and drills</p>
				<h1>The slate, the game, the numbers behind it.</h1>
				<p class="lede">
					Today's NBA games, a page for each one, and a catalogue of drills. Scores are
					fetched once, cached, and refreshed on a timer, so reading a page does not spend a
					request — and a snapshot that has gone stale says so instead of pretending to be live.
				</p>
				<div class="cta-row">
					<a href="/nba">Open today's slate</a>
					<a href="/drills" class="secondary">Browse the drills</a>
					<a href="/about" class="secondary">About this site</a>
				</div>
			</section>

			<section class="feature-grid">
				<article>
					<h2>Today's slate</h2>
					<p>Every game on the day with its status, tip-off time and line score. A live slate costs at most one request a minute; a settled one costs nothing for half a day.</p>
				</article>
				<article>
					<h2>One page per game</h2>
					<p>Quarter lines, overtime when it was needed, tip-off, stage and both teams — with timeouts and the bonus while the game is being played.</p>
				</article>
				<article>
					<h2>The drill catalogue</h2>
					<p>One markdown file per drill, each naming the numbers a session records, so the catalogue cannot promise a measurement the tables cannot store.</p>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-shell {
		max-width: 1100px;
		margin: 0 auto;
		padding: 4rem 1.5rem 5rem;
	}

	.hero {
		padding: 2rem 0 3rem;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: rgb(var(--gray));
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(2.5rem, 6vw, 5rem);
		line-height: 0.95;
	}

	.lede {
		max-width: 44rem;
		margin-top: 1.25rem;
		font-size: 1.15rem;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.cta-row a {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.4rem;
		border-radius: 999px;
		background: rgb(var(--black));
		color: white;
		text-decoration: none;
		font-weight: 600;
	}

	.cta-row a.secondary {
		background: transparent;
		border: 1px solid rgb(var(--gray-light));
		color: rgb(var(--black));
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		margin-top: 1rem;
	}

	.feature-grid article {
		padding: 1.5rem;
		border: 1px solid rgba(var(--gray-light), 0.8);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.7);
	}

	.feature-grid h2 {
		margin-top: 0;
		margin-bottom: 0.75rem;
		font-size: 1.1rem;
	}

	.feature-grid p {
		margin: 0;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 720px) {
		.feature-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
