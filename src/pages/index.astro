---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="page-shell">
			<section class="hero">
				<p class="eyebrow">A personal corner of the web</p>
				<h1>Thoughtful writing for curious builders.</h1>
				<p class="lede">
					Northstar Notes is a lightweight journal for product ideas, engineering experiments,
					and lessons learned while building in public.
				</p>
				<div class="cta-row">
					<a href="/blog">Read the journal</a>
					<a href="/about" class="secondary">Learn more</a>
				</div>
			</section>

			<section class="feature-grid">
				<article>
					<h2>What I write about</h2>
					<p>Product thinking, development workflows, shipping faster, and the small details that make systems resilient.</p>
				</article>
				<article>
					<h2>What I value</h2>
					<p>Clear communication, deliberate iteration, and building experiences that are useful before they are flashy.</p>
				</article>
				<article>
					<h2>How I work</h2>
					<p>Ship small, learn quickly, write down the lessons, and keep improving the system that supports the work.</p>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-shell {
		max-width: 1100px;
		margin: 0 auto;
		padding: 4rem 1.5rem 5rem;
	}

	.hero {
		padding: 2rem 0 3rem;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: rgb(var(--gray));
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(2.5rem, 6vw, 5rem);
		line-height: 0.95;
	}

	.lede {
		max-width: 44rem;
		margin-top: 1.25rem;
		font-size: 1.15rem;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.cta-row a {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.4rem;
		border-radius: 999px;
		background: rgb(var(--black));
		color: white;
		text-decoration: none;
		font-weight: 600;
	}

	.cta-row a.secondary {
		background: transparent;
		border: 1px solid rgb(var(--gray-light));
		color: rgb(var(--black));
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		margin-top: 1rem;
	}

	.feature-grid article {
		padding: 1.5rem;
		border: 1px solid rgba(var(--gray-light), 0.8);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.7);
	}

	.feature-grid h2 {
		margin-top: 0;
		margin-bottom: 0.75rem;
		font-size: 1.1rem;
	}

	.feature-grid p {
		margin: 0;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 720px) {
		.feature-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
