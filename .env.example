# Copy to `.env` for local development, then fill in from the Supabase project's
# Settings -> API page and the balldontlie dashboard.
#
# Every variable here is server-side. None is prefixed PUBLIC_, so none reaches
# the browser bundle; the service-role key bypasses row level security and must
# never be sent to a client.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# The publishable key. Carried because the local stack and the dashboard expect
# it, but the site itself never uses it: the Data API has no access to any table
# (see supabase/migrations/*_lock_down_data_api.sql).
SUPABASE_ANON_KEY=

# Bypasses row level security. Server side only, and never leaves the container.
SUPABASE_SERVICE_ROLE_KEY=

# balldontlie API key, sent as the Authorization header.
BALLDONTLIE_API_KEY=

# Upstream requests the service may spend in one UTC day, shared by both tasks.
NBA_DAILY_REQUEST_BUDGET=400

# Everything above is what the deployed task reads -- but not from this file. It
# reads it from SSM Parameter Store (/blog/... in us-east-1), which
# scripts/put-ssm-parameters.sh fills from this file (ticket #94). The container's
# environment is populated by ECS at task start, so this file is for local runs.

# Not read by the application either. This one belongs in GitHub repository
# secrets for the migration workflow (#96): the database connection string, using
# the session pooler host on port 5432. A free-tier project has no direct IPv4
# route, and the transaction pooler (6543) cannot run migrations.
# SUPABASE_DB_URL=
